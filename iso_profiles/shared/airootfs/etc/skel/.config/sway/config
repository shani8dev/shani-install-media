exec swaybg -i /usr/share/backgrounds/shani/saturn-x.png -m fill
set $mod Mod4
set $term foot
exec os-installer
bindsym $mod+Return exec $term
bindsym Ctrl+Alt+t exec $term
# the screen reader, on the shortcut GNOME uses: Super+Alt+S starts Orca, and
# again stops it
bindsym $mod+Alt+s exec sh -c 'pkill -x orca || orca --replace'
