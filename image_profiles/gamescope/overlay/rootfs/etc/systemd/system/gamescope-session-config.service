# Populate the tmpfs gamescope home from skel on every boot.
# Adapted from the systemd-guest-user pattern (Akrai/systemd-guest-user, GPLv3).
[Unit]
DefaultDependencies=no
Requires=home-gamescope.mount
After=systemd-tmpfiles-setup.service home-gamescope.mount
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'cp -a /etc/skel/. /home/gamescope/'
ExecStart=/usr/bin/chown -R gamescope:users /home/gamescope
RemainAfterExit=yes