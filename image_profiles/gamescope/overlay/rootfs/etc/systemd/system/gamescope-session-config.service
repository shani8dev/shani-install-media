# Populate the persistent gamescope home from skel on first boot only.
# The home lives on the @home subvolume (no tmpfs), so Steam's login, library
# and Flatpak data persist. Copying skel on every boot would overwrite the
# user's configs, so gate it on the home not yet having a .config directory.
[Unit]
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'if [ ! -e /home/gamescope/.config ]; then cp -a /etc/skel/. /home/gamescope/; chown -R gamescope:users /home/gamescope; fi'
RemainAfterExit=yes