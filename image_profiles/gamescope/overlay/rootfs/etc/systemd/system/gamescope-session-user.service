# Idempotent gamescope user creation (passwordless — greetd's initial_session
# does not prompt, and the login PAM stack allows an empty password).
# The home lives on the persistent @home subvolume (mounted at /home), not a
# tmpfs: Steam's login, library and Flatpak data must survive reboots, like
# SteamOS's /home/deck.
[Unit]
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'id gamescope >/dev/null 2>&1 || useradd -c "Gaming session user" -m -d /home/gamescope -s /bin/bash -g users -G input,video,render,audio,storage,network gamescope'
ExecStart=/usr/bin/usermod -d /home/gamescope -g users -s /bin/bash gamescope
ExecStart=/usr/bin/usermod -aG input,video,render,audio,storage,network gamescope
ExecStart=/usr/bin/install -d -o gamescope -g users /home/gamescope
ExecStart=/usr/bin/passwd -d gamescope
RemainAfterExit=yes