# Idempotent gamescope user creation (passwordless — gdm autologin requires it).
# Adapted from the systemd-guest-user pattern (Akrai/systemd-guest-user, GPLv3).
[Unit]
DefaultDependencies=no
Before=systemd-tmpfiles-setup.service
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'id gamescope >/dev/null 2>&1 || useradd -c "Gaming session user" gamescope'
ExecStart=/usr/bin/usermod -d /home/gamescope/ gamescope
ExecStart=/usr/bin/chsh -s /bin/bash gamescope
ExecStart=/usr/bin/passwd -d gamescope
RemainAfterExit=yes