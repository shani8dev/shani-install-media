{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 8,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["backlight", "pulseaudio", "network", "battery", "custom/weather", "custom/session", "custom/power", "tray"],
  "backlight": {
    "format": "☀ {percent}%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "custom/weather": {
    "exec": "curl -s 'wttr.in/?format=%c+%t' 2>/dev/null || echo ''",
    "interval": 3600,
    "return-type": "plain"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "shani-gamescope-control"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "custom/session": {
    "format": "󰒉 Game mode",
    "tooltip": false,
    "on-click": "foot -e sudo gamescope-session-select steam"
  }
}