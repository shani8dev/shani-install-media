# Kiosk home lives entirely in tmpfs — nothing written to disk survives reboot.
# Adapted from the systemd-guest-user pattern (Akrai/systemd-guest-user, GPLv3).
[Unit]
Conflicts=umount.target
Before=umount.target
RefuseManualStart=yes
RefuseManualStop=yes

[Mount]
What=tmpfs
Where=/home/kiosk
Type=tmpfs
Options=mode=0750,uid=kiosk,gid=users,strictatime,nosuid,nodev
