# Idempotent kiosk user creation (passwordless — gdm autologin requires it).
# Adapted from the systemd-guest-user pattern (Akrai/systemd-guest-user, GPLv3).
[Unit]
DefaultDependencies=no
Before=systemd-tmpfiles-setup.service
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'id kiosk >/dev/null 2>&1 || useradd -c "Kiosk session user" kiosk'
ExecStart=/usr/bin/usermod -d /home/kiosk/ kiosk
ExecStart=/usr/bin/chsh -s /bin/bash kiosk
ExecStart=/usr/bin/passwd -d kiosk
