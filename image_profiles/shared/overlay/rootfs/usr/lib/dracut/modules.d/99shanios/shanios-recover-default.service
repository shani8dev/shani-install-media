[Unit]
Description=ShaniOS: recover the boot default after a failed root mount
Documentation=man:systemd.special(7)
# Only meaningful once we are already in trouble. dracut's emergency shell is a
# full systemd instance in the initramfs, so this is what turns "the hook
# rewrote loader.conf for the NEXT boot" into "this boot reboots into the good
# slot instead".
#
# NOT WantedBy=emergency.target statically: this is enabled at runtime by the
# pre-mount hook, and only when it has found a prior-failure marker. Arming it
# unconditionally would make every single boot that fails to mount the root
# reboot once, which for a transient failure is a reboot nobody asked for.
# DefaultDependencies=no, because the initramfs has no basic.target and the
# default dependencies would order this behind targets that do not exist.
DefaultDependencies=no
After=initrd-root-fs.target

# NO `Conflicts=emergency.target`. This unit used to carry it, alongside
# `WantedBy=emergency.target`, and the two together meant it could never run:
# arming creates the symlink under emergency.target.wants/, emergency.target
# then starts, and `Conflicts` tells systemd to STOP any unit that conflicts
# with the target it is starting - which is this one. It armed successfully on
# every boot and was killed by the very target it was waiting for.
#
# Measured, in this order, on a real boot: `unit-present=yes`, then
# `armed emergency-mode default recovery (this boot, not the next)`, then
# emergency mode, and the unit's ExecStart never ran - no output from
# shanios-recover-default.sh at all, and the machine sat in the shell until the
# harness timeout. An armed unit that never starts is indistinguishable from an
# unarmed one unless you read the arming line, which is why it looked like the
# arming was failing.

[Service]
Type=oneshot
RemainAfterExit=yes
# The script's own guards are the real safety net (prior marker required,
# tries-counted default required, fallback entry must exist, rewrite verified
# before rebooting). This is defence in depth for a script that reboots.
TimeoutStartSec=90
ExecStart=/usr/lib/dracut/modules.d/99shanios/shanios-recover-default.sh
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=emergency.target